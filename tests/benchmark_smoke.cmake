set(options)
if(DISABLE_AVX2)
    list(APPEND options --disable-avx2)
endif()
execute_process(COMMAND "${BENCHMARK}" --list-variants ${options}
    RESULT_VARIABLE list_status OUTPUT_VARIABLE variant_text)
string(STRIP "${variant_text}" variant_text)
string(REPLACE "\n" ";" variants "${variant_text}")
if(NOT list_status EQUAL 0 OR NOT (variants STREQUAL
        "scalar;compiler_optimized;compiler_reassociated" OR
        variants STREQUAL "scalar;compiler_optimized;compiler_reassociated;manual_avx2"))
    message(FATAL_ERROR "Unexpected variant list: ${variant_text}")
endif()
if(DISABLE_AVX2 AND NOT variants STREQUAL
        "scalar;compiler_optimized;compiler_reassociated")
    message(FATAL_ERROR "Disabled AVX2 was still selected")
endif()
list(LENGTH variants variant_count)
math(EXPR expected_rows "1 + 6 * ${variant_count} * 2")
execute_process(COMMAND "${BENCHMARK}" --smoke ${options}
    RESULT_VARIABLE status OUTPUT_VARIABLE csv ERROR_VARIABLE errors)
if(NOT status EQUAL 0)
    message(FATAL_ERROR "Benchmark smoke failed: ${errors}")
endif()
string(STRIP "${csv}" csv)
string(REPLACE "\n" ";" rows "${csv}")
list(LENGTH rows count)
if(NOT count EQUAL expected_rows)
    message(FATAL_ERROR "Expected ${expected_rows} CSV rows; got ${count}")
endif()
list(POP_FRONT rows header)
if(NOT header STREQUAL "variant,arch,build_type,mode,n,sample,iterations,elapsed_ns,ns_per_call,result")
    message(FATAL_ERROR "Unexpected CSV header: ${header}")
endif()
set(row_index 0)
foreach(n IN ITEMS 256 1024 4096 16384 65536 1048576)
    foreach(variant IN LISTS variants)
        foreach(sample IN ITEMS 0 1)
            list(GET rows ${row_index} row)
            if(NOT row MATCHES "^${variant},[^,]+,Release,smoke,${n},${sample},[0-9]+,[0-9.e+E-]+,[0-9.e+E-]+,[-0-9.e+E]+$")
                message(FATAL_ERROR "Invalid CSV row: ${row}")
            endif()
            string(REPLACE "," ";" fields "${row}")
            foreach(index IN ITEMS 6 7 8)
                list(GET fields ${index} value)
                if(NOT value GREATER 0)
                    message(FATAL_ERROR "Non-positive iteration count or timing: ${row}")
                endif()
            endforeach()
            math(EXPR row_index "${row_index} + 1")
        endforeach()
    endforeach()
endforeach()
execute_process(COMMAND "${BENCHMARK}" --unknown
    RESULT_VARIABLE bad_status OUTPUT_VARIABLE bad_csv ERROR_QUIET)
if(NOT bad_status EQUAL 2 OR NOT bad_csv STREQUAL "")
    message(FATAL_ERROR "Unknown options must fail without emitting CSV")
endif()
